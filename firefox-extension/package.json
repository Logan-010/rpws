{
  "name": "rpws-firefox-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../web --target web --out-dir ../firefox-extension/wasm --out-name web --release",
    "build:ui": "vite build",
    "build": "npm run build:wasm && npm run build:ui",
    "lint": "web-ext lint --source-dir dist --warnings-as-errors",
    "test": "node tests/wasm-smoke.mjs && node --test tests/popup-state.test.mjs tests/autofill.test.mjs",
    "start": "web-ext run --source-dir dist",
    "package": "web-ext build --source-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wasm-pack": "0.15.0",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  },
  "allowScripts": {
    "wasm-pack@0.15.0": true,
    "core-js@2.6.12": true,
    "core-js@3.6.5": true,
    "dtrace-provider@0.8.8": true,
    "spawn-sync@1.0.15": true
  }
}
