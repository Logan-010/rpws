{
  "name": "rpws-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../web --target web --out-dir ../chrome-extension/wasm --out-name web --release",
    "build:ui": "vite build",
    "build": "npm run build:wasm && npm run build:ui",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wasm-pack": "0.15.0"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  },
  "allowScripts": {
    "wasm-pack@0.15.0": true
  }
}
